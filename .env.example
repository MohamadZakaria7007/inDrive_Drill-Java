# Copy to .env (git-ignored). Lookup order: -DKEY=value  >  environment variable  >  .env
# Fill in only what the task needs; CI sets these from secrets.

UI_BASE_URL=https://practicesoftwaretesting.com
UI_USERNAME=
UI_PASSWORD=
# Attribute behind Locators.testId(): data-testid | data-test | data-qa | data-cy ...
TEST_ID_ATTRIBUTE=data-test
# chrome | firefox | edge
BROWSER=chrome
HEADLESS=true
UI_TIMEOUT_SECONDS=10

API_BASE_URL=https://api.practicesoftwaretesting.com
API_TOKEN=
API_TIMEOUT_SECONDS=15
